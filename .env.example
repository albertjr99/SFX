# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# development | production
SFX_ENV=development

# Obrigatória em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Padrão: SQLite em instance/producao.db (mesmo arquivo da versão 1).
# PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/sfx
# DATABASE_URL=sqlite:///producao.db

# Contatos exibidos na tela de login ("Nome <email>; Nome <email>")
# SFX_CONTATOS=Fulano de Tal <fulano@orgao.gov.br>; Ciclana <ciclana@orgao.gov.br>

# SFX_NOME_SETOR=Subgerência de Fixação
# SFX_SIGLA=SFX
# SFX_INSTITUICAO=IPAJM
# Fuso usado em todas as datas exibidas e no "hoje" do sistema (padrão: São Paulo, UTC−3)
# SFX_FUSO=America/Sao_Paulo
# TZ=America/Sao_Paulo         # horário dos logs do servidor

# Segurança
# SESSION_COOKIE_SECURE=true   # padrão em produção; use false se servir sem HTTPS na intranet
# PROXY_FIX=true               # quando atrás de nginx/IIS/traefik
# SFX_TENTATIVAS_LOGIN=5
# SFX_JANELA_LOGIN_MIN=10
# SFX_SENHA_MINIMA=8
